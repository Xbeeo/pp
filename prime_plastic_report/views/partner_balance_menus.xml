<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit wizard view: filter partner_ids by context -->
    <record id="view_customer_balance_wizard" model="ir.ui.view">
        <field name="name">customer.balance.wizard</field>
        <field name="model">account.report.partner.ledger</field>
        <field name="inherit_id" ref="accounting_pdf_reports.account_report_partner_ledger_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="partner_ids" position="attributes">
                <attribute name="domain">[('customer_rank', '>', 0)]</attribute>
            </field>
            <field name="partner_ids" position="after">
                <field name="partner_type" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- Wizard view for vendors -->
    <record id="view_vendor_balance_wizard" model="ir.ui.view">
        <field name="name">vendor.balance.wizard</field>
        <field name="model">account.report.partner.ledger</field>
        <field name="inherit_id" ref="accounting_pdf_reports.account_report_partner_ledger_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="partner_ids" position="attributes">
                <attribute name="domain">[('supplier_rank', '>', 0)]</attribute>
            </field>
            <field name="partner_ids" position="after">
                <field name="partner_type" invisible="1"/>
            </field>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_customer_balance_report" model="ir.actions.act_window">
        <field name="name">Customer Balance Report</field>
        <field name="res_model">account.report.partner.ledger</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_customer_balance_wizard"/>
        <field name="target">new</field>
        <field name="context">{'default_result_selection': 'customer', 'partner_type': 'customer'}</field>
    </record>

    <record id="action_vendor_balance_report" model="ir.actions.act_window">
        <field name="name">Vendor Balance Report</field>
        <field name="res_model">account.report.partner.ledger</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_vendor_balance_wizard"/>
        <field name="target">new</field>
        <field name="context">{'default_result_selection': 'supplier', 'partner_type': 'supplier'}</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_customer_balance_report"
              name="Customer Balance Report"
              parent="accounting_pdf_reports.menu_finance_partner_reports"
              action="action_customer_balance_report"
              sequence="90"/>

    <menuitem id="menu_vendor_balance_report"
              name="Vendor Balance Report"
              parent="accounting_pdf_reports.menu_finance_partner_reports"
              action="action_vendor_balance_report"
              sequence="91"/>

</odoo>