<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_order_form_transport" model="ir.ui.view">
        <field name="name">purchase.order.form.transport</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>

        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="Transport Info">

                    <group>

                        <group string="Transport Details">

                            <field name="transport_driver_id"/>

                            <field name="transport_vehicle_id"/>

                        </group>

                    </group>

                </page>

            </xpath>

        </field>

    </record>

</odoo>