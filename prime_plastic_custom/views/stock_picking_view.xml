<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_stock_picking_form_transport" model="ir.ui.view">
        <field name="name">stock.picking.form.transport</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="transport_driver_id"/>
                <field name="transport_vehicle_id"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom']" position="attributes">
                <attribute name="width">90px</attribute>
            </xpath>

            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom']" position="after">
                <field name="product_standard_weight"
                       width="110px"
                       optional="show"
                       column_invisible="parent.picking_type_code != 'incoming'"/>
                <field name="receiving_weight"
                       width="130px"
                       optional="show"
                       readonly="state in ('done', 'cancel')"
                       column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>

</odoo>